# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# OpenAI
OPENAI_API_KEY=sk-...

# LemonSqueezy (primary billing provider)
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=
LEMONSQUEEZY_VARIANT_STARTER=
LEMONSQUEEZY_VARIANT_PRO=
LEMONSQUEEZY_VARIANT_BUSINESS=

# Stripe (optional fallback — kept for backwards compatibility)
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_STARTER=price_...
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_BUSINESS=price_...

# Resend (transactional email)
RESEND_API_KEY=re_...

# Cron jobs (used by /api/cron/* routes). Generate a strong random value.
CRON_SECRET=replace-with-a-strong-random-string

# Trial-abuse blocklist salt (set once, never change)
EMAIL_FINGERPRINT_SALT=replace-with-a-strong-random-string

# Application URL (used in checkout redirect URLs and emails)
NEXT_PUBLIC_APP_URL=http://localhost:3000
